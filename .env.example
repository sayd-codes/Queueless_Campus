# QueueLess Campus - email settings
#
# 1. Copy this file to a new file named ".env" (same folder):   copy .env.example .env
# 2. Fill in the values below, save, then restart the app.
# 3. NEVER upload ".env" to GitHub (it is already listed in .gitignore).
#
# Put comments on their own line (like these). Do not write "# comment" after a value.
#
# While SMTP_USER / SMTP_PASSWORD are empty the app runs in PREVIEW mode: nothing is sent,
# every email is saved and can be read in the admin "Notifications" tab.

# smtp = really send, console = preview only, off = no emails. Leave empty to auto-detect.
EMAIL_MODE=

# Gmail: smtp.gmail.com / 587.   Outlook: smtp-mail.outlook.com / 587.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# The mailbox that sends the notifications.
SMTP_USER=
# Gmail needs a 16-character "App password" here, NOT your normal password (see docs/NOTIFICATIONS.md).
SMTP_PASSWORD=

# Optional: show a different sender address (defaults to SMTP_USER) and name.
SMTP_FROM=
EMAIL_FROM_NAME=QueueLess Campus

# Optional: a "Track your token" link added to every email (your deployed app address).
APP_URL=http://localhost:8501
